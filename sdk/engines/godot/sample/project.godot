; PoPLY Godot sample integration — a dedicated-server-style project that submits a signed
; Proof-of-Play checkpoint through the poply addon against a running publisher verifier.
; Run headlessly via scripts/godot-e2e.sh (which copies the addon in and boots the verifier).

config_version=5

[application]

config/name="PoPLY Godot Sample"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
