{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.example/schemas/poply/phygital-binding-v1.json",
  "title": "PoPLY Phygital Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "bindingId", "characterContract", "tokenId", "issuer",
    "devicePublicKey", "productId", "issuedAt", "attestation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "bindingId": { "$ref": "#/$defs/bytes32" },
    "characterContract": { "$ref": "#/$defs/address" },
    "tokenId": { "$ref": "#/$defs/uintString" },
    "issuer": { "$ref": "#/$defs/address" },
    "devicePublicKey": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$", "minLength": 68, "maxLength": 266 },
    "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "manufacturingBatch": { "type": "string", "maxLength": 128 },
    "issuedAt": { "$ref": "#/$defs/uintString" },
    "attestation": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$", "minLength": 132 },
    "revocationUrl": { "type": "string", "format": "uri" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
