{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.example/schemas/poply/marketplace-listing-v1.json",
  "title": "PoPLY Marketplace Listing v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "characterContract", "tokenId", "seller", "priceWei", "deadline"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "characterContract": { "$ref": "#/$defs/address" },
    "tokenId": { "$ref": "#/$defs/uintString" },
    "seller": { "$ref": "#/$defs/address" },
    "priceWei": { "$ref": "#/$defs/uintString" },
    "deadline": { "$ref": "#/$defs/uintString" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
