{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.example/schemas/poply/character-metadata-v1.json",
  "title": "PoPLY Character Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameId", "characterId", "name", "media", "attributes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "gameId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "characterId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "format": "uri" },
        "animation": { "type": "string", "format": "uri" },
        "model": { "type": "string", "format": "uri" }
      }
    },
    "attributes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trait", "value"],
        "properties": {
          "trait": { "type": "string", "minLength": 1, "maxLength": 80 },
          "value": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          },
          "displayType": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "externalUrl": { "type": "string", "format": "uri" }
  }
}
