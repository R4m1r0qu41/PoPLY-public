{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.example/schemas/poply/license-offer-v1.json",
  "title": "PoPLY Character License Offer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "characterContract", "tokenId", "licensor", "mode",
    "priceWei", "durationSeconds", "deadline", "termsHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "characterContract": { "$ref": "#/$defs/address" },
    "tokenId": { "$ref": "#/$defs/uintString" },
    "licensor": { "$ref": "#/$defs/address" },
    "allowedLicensee": { "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
    "mode": {
      "enum": ["NPC", "TOURNAMENT", "SEASONAL_BOSS", "STORY_CAMPAIGN", "PROMOTIONAL_APPEARANCE", "AI_AGENT"]
    },
    "priceWei": { "$ref": "#/$defs/uintString" },
    "durationSeconds": { "$ref": "#/$defs/uintString" },
    "deadline": { "$ref": "#/$defs/uintString" },
    "termsHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
