{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherlayer.example/schemas/poply/checkpoint-v1.json",
  "title": "PoPLY Proof-of-Play Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "characterContract", "tokenId", "gameId", "sequence", "stateHash",
    "playTimeSeconds", "popl", "policyId", "occurredAt", "deadline"
  ],
  "properties": {
    "characterContract": { "$ref": "#/$defs/address" },
    "tokenId": { "$ref": "#/$defs/uintString" },
    "gameId": { "$ref": "#/$defs/bytes32" },
    "sequence": { "$ref": "#/$defs/uintString" },
    "stateHash": { "$ref": "#/$defs/bytes32" },
    "playTimeSeconds": { "$ref": "#/$defs/uintString" },
    "popl": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "policyId": { "$ref": "#/$defs/bytes32" },
    "occurredAt": { "$ref": "#/$defs/uintString" },
    "deadline": { "$ref": "#/$defs/uintString" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
